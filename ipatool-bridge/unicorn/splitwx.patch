diff --git a/uc.c b/uc.c
index fd2ee1b..5dea85a 100644
--- a/uc.c
+++ b/uc.c
@@ -3067,3 +3067,112 @@ void trace_end(uc_tracer *tracer, trace_loc loc, const char *fmt, ...)
             (double)(end - tracer->starts[loc]) / (double)(1000));
 }
 #endif
+
+/*
+ * Split W^X (warpsign-neo): code buffers come from one region mapped twice,
+ * writable at rw and executable at rx. See qemu/include/tcg/tcg-splitwx.h.
+ */
+#include "qemu/include/tcg/tcg-splitwx.h"
+
+uintptr_t uc_splitwx_rw_start;
+uintptr_t uc_splitwx_rw_end;
+uintptr_t uc_splitwx_diff;
+
+#if !defined(_WIN32) && !defined(UNICORN_HAS_OSXKERNEL)
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define SPLITWX_MAX_SLICES 64
+
+static pthread_mutex_t splitwx_lock = PTHREAD_MUTEX_INITIALIZER;
+static size_t splitwx_slice;
+static size_t splitwx_slices;
+static uint64_t splitwx_used;
+
+UNICORN_EXPORT
+uc_err uc_splitwx_configure(void *rw, void *rx, size_t size, size_t slice)
+{
+    size_t page = (size_t)sysconf(_SC_PAGESIZE);
+    uc_err err = UC_ERR_OK;
+
+    if (rw == NULL || rx == NULL || slice == 0 || slice % page != 0 ||
+        size < slice || size / slice > SPLITWX_MAX_SLICES ||
+        ((uintptr_t)rw - (uintptr_t)rx) % page != 0) {
+        return UC_ERR_ARG;
+    }
+    pthread_mutex_lock(&splitwx_lock);
+    if (uc_splitwx_rw_end != 0) {
+        // Once only: engines may be running from the region already
+        err = UC_ERR_ARG;
+    } else {
+        splitwx_slice = slice;
+        splitwx_slices = size / slice;
+        splitwx_used = 0;
+        uc_splitwx_rw_start = (uintptr_t)rw;
+        uc_splitwx_diff = (uintptr_t)rx - (uintptr_t)rw;
+        uc_splitwx_rw_end = (uintptr_t)rw + splitwx_slices * slice;
+    }
+    pthread_mutex_unlock(&splitwx_lock);
+    return err;
+}
+
+void *uc_splitwx_alloc(size_t *size)
+{
+    void *buf = NULL;
+    size_t i;
+
+    pthread_mutex_lock(&splitwx_lock);
+    for (i = 0; i < splitwx_slices; i++) {
+        if (!(splitwx_used & (1ULL << i))) {
+            splitwx_used |= 1ULL << i;
+            buf = (void *)(uc_splitwx_rw_start + i * splitwx_slice);
+            break;
+        }
+    }
+    pthread_mutex_unlock(&splitwx_lock);
+    if (buf == NULL) {
+        fprintf(stderr, "Unicorn: all %zu split W^X code buffers are in use\n",
+                splitwx_slices);
+        return NULL;
+    }
+    if (*size == 0 || *size > splitwx_slice) {
+        *size = splitwx_slice;
+    }
+    return buf;
+}
+
+bool uc_splitwx_free(void *buf)
+{
+    uintptr_t p = (uintptr_t)buf;
+    size_t i;
+
+    if (p < uc_splitwx_rw_start || p >= uc_splitwx_rw_end) {
+        return false;
+    }
+    i = (p - uc_splitwx_rw_start) / splitwx_slice;
+    // TCG puts guard pages in its buffer: make the slice writable again
+    mprotect((void *)(uc_splitwx_rw_start + i * splitwx_slice), splitwx_slice,
+             PROT_READ | PROT_WRITE);
+    pthread_mutex_lock(&splitwx_lock);
+    splitwx_used &= ~(1ULL << i);
+    pthread_mutex_unlock(&splitwx_lock);
+    return true;
+}
+#else
+UNICORN_EXPORT
+uc_err uc_splitwx_configure(void *rw, void *rx, size_t size, size_t slice)
+{
+    return UC_ERR_ARG;
+}
+
+void *uc_splitwx_alloc(size_t *size)
+{
+    return NULL;
+}
+
+bool uc_splitwx_free(void *buf)
+{
+    return false;
+}
+#endif
