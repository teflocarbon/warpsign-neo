+/*
+ * Split W^X: the distance from where this code runs to target, in
+ * instructions. Targets in the code buffer run from rx like this code;
+ * helpers outside it are where they are.
+ */
+static inline ptrdiff_t tcg_splitwx_branch(TCGContext *s, tcg_insn_unit *target)
+{
+    return ((intptr_t)tcg_splitwx_to_rx((uintptr_t)target) -
+            (intptr_t)tcg_splitwx_to_rx((uintptr_t)s->code_ptr)) >> 2;
+}
+
 static inline void tcg_out_goto(TCGContext *s, tcg_insn_unit *target)
 {
-    ptrdiff_t offset = target - s->code_ptr;
+    ptrdiff_t offset = tcg_splitwx_branch(s, target);
     tcg_debug_assert(offset == sextract64(offset, 0, 26));
     tcg_out_insn(s, 3206, B, offset);
 }
 
 static inline void tcg_out_goto_long(TCGContext *s, tcg_insn_unit *target)
 {
-    ptrdiff_t offset = target - s->code_ptr;
+    ptrdiff_t offset = tcg_splitwx_branch(s, target);
     if (offset == sextract64(offset, 0, 26)) {
         tcg_out_insn(s, 3206, BL, offset);
     } else {
-        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP, (intptr_t)target);
+        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP,
+                     tcg_splitwx_to_rx((uintptr_t)target));
         tcg_out_insn(s, 3207, BR, TCG_REG_TMP);
     }
 }
@@ -1337,11 +1351,12 @@ static inline void tcg_out_callr(TCGContext *s, TCGReg reg)
 
 static inline void tcg_out_call(TCGContext *s, tcg_insn_unit *target)
 {
-    ptrdiff_t offset = target - s->code_ptr;
+    ptrdiff_t offset = tcg_splitwx_branch(s, target);
     if (offset == sextract64(offset, 0, 26)) {
         tcg_out_insn(s, 3206, BL, offset);
     } else {
-        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP, (intptr_t)target);
+        tcg_out_movi(s, TCG_TYPE_I64, TCG_REG_TMP,
+                     tcg_splitwx_to_rx((uintptr_t)target));
