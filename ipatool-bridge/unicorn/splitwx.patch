diff --git a/qemu/tcg/tcg.c b/qemu/tcg/tcg.c
index bc62051..529df41 100644
--- a/qemu/tcg/tcg.c
+++ b/qemu/tcg/tcg.c
@@ -354,7 +354,8 @@ TranslationBlock *tcg_tb_lookup(TCGContext *tcg_ctx, uintptr_t tc_ptr)
 {
     TranslationBlock *tb;
 
-    struct tb_tc s = { .ptr = (void *)tc_ptr };
+    /* Return addresses from generated code are rx ones (split W^X) */
+    struct tb_tc s = { .ptr = (void *)tcg_splitwx_to_rw(tc_ptr) };
