diff --git a/qemu/include/tcg/tcg-splitwx.h b/qemu/include/tcg/tcg-splitwx.h
new file mode 100644
index 0000000..d487b9c
--- /dev/null
+++ b/qemu/include/tcg/tcg-splitwx.h
@@ -0,0 +1,61 @@
+/*
+ * Split W^X for iOS 26 and later (warpsign-neo).
+ *
+ * Where TXM is present, an app with JIT gets executable memory only from
+ * regions its debugger prepared, and may write to them only through a
+ * second, writable mapping of the same memory. So generated code is
+ * written through the writable mapping (rw) and run from the executable
+ * one (rx), a fixed distance apart (uc_splitwx_diff).
+ *
+ * TCG keeps every code pointer in its rw form. Only what executes sees rx
+ * addresses: entering generated code, the pointers lookup_tb_ptr returns,
+ * PC-relative displacements (computed from rx addresses) and return
+ * addresses coming back from it, which are turned back into rw ones.
+ *
+ * Code buffers come from one region set up before any engine with
+ * uc_splitwx_configure(), handed out in slices. Without it, everything
+ * here is the identity and Unicorn works as it always has.
+ */
+
+#ifndef TCG_SPLITWX_H
+#define TCG_SPLITWX_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+/* The writable mapping's range; both 0 when split W^X isn't in use */
+extern uintptr_t uc_splitwx_rw_start;
+extern uintptr_t uc_splitwx_rw_end;
+/* rx - rw */
+extern uintptr_t uc_splitwx_diff;
+
+static inline bool tcg_splitwx_enabled(void)
+{
+    return uc_splitwx_rw_end != 0;
+}
+
+/* The executable address of p, if p is in the writable mapping */
+static inline uintptr_t tcg_splitwx_to_rx(uintptr_t p)
+{
+    return p - uc_splitwx_rw_start < uc_splitwx_rw_end - uc_splitwx_rw_start
+               ? p + uc_splitwx_diff
+               : p;
+}
+
+/* The writable address of p, if p is in the executable mapping */
+static inline uintptr_t tcg_splitwx_to_rw(uintptr_t p)
+{
+    uintptr_t rx_start = uc_splitwx_rw_start + uc_splitwx_diff;
+    return p - rx_start < uc_splitwx_rw_end - uc_splitwx_rw_start
+               ? p - uc_splitwx_diff
+               : p;
+}
+
+/* A slice of the region for a code buffer of up to *size bytes (*size is
+   set to the slice's size), as its writable address; NULL if none is free */
+void *uc_splitwx_alloc(size_t *size);
+/* Give a slice back; false if buf isn't one */
+bool uc_splitwx_free(void *buf);
+
+#endif
