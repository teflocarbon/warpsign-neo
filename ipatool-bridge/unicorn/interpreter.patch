+
+static void
+tci_write_reg(tcg_target_ulong *regs, TCGReg index, tcg_target_ulong value)
+{
+    tci_assert(index < TCG_TARGET_NB_REGS);
+    tci_assert(index != TCG_AREG0);
+    tci_assert(index != TCG_REG_CALL_STACK);
+    regs[index] = value;
